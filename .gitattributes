# Set default behavior to automatically normalize line endings
* text=auto

# Force text files to have LF line endings on checkout
*.dart text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.xml text eol=lf
*.gradle text eol=lf
*.properties text eol=lf
*.kt text eol=lf
*.swift text eol=lf
*.m text eol=lf
*.h text eol=lf

# Denote all files that are truly binary and should not be modified
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
*.tar binary
*.gz binary
*.7z binary
*.rar binary

# Flutter/Dart specific
*.lock text eol=lf
pubspec.yaml text eol=lf
analysis_options.yaml text eol=lf

# Android specific
*.apk binary
*.aab binary
*.so binary

# iOS specific
*.ipa binary
*.framework binary
*.xcodeproj/** text eol=lf
*.xcworkspace/** text eol=lf
*.pbxproj text eol=lf